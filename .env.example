# Client-only static showcase — VITE_* vars only, no server secrets.
# Copy to .env (frontend picks these up at build time).

# App
VITE_APP_NAME=generated-project

# Contact forms via cloud-edge client actions.
# 1) Formspree (recommended, zero server): create a form at https://formspree.io
#    then paste your endpoint:
VITE_FORMSPREE_ENDPOINT=
#    Optional second formspree form id for the newsletter/subscribe action:
VITE_FORMSPREE_NEWSLETTER_ID=

# 2) Resend / generic webhook (client action): point this at a serverless
#    edge function (Vercel/Netlify) or webhook that fans out to Resend.
VITE_CONTACT_WEBHOOK_URL=

# Without either endpoint the forms fall back to a dev mock (no network).
